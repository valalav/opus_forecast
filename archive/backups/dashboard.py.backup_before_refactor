    col2.metric(
        "🎯 Seasonal",
        f"KPI: {kpi_seasonal}/{len(bt_data)}",
        f"MAE: {errors_seasonal.mean():.3f}",
    )
    col3.metric(
        "📊 Bias", f"KPI: {kpi_bias}/{len(bt_data)}", f"MAE: {errors_bias.mean():.3f}"
    )


