ensamble <- ml_mean_forecasts %>% filter(model != "ipc")
ggplot(filter(ensamble, model != "ipc"), aes(date, value, color = model)) +
geom_line(aes(date, value, color = model)) +
geom_line(data = filter(ensamble, model == "ipc"), linetype = "dashed") +
theme_bw() +
theme(
# X axis
axis.title.x = element_blank(),
axis.text.x = element_text(size = 12, color = "black"),
# Y axis
axis.title.y = element_blank(),
axis.text.y = element_text(size = 12, color = "black"),
# Title
plot.title = element_blank(),
# Panel
panel.grid = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major.x = element_blank(),
panel.background = element_rect(fill = "white", color = "black"),
# Legend
legend.title = element_blank(),
legend.text = element_text(size = 11),
legend.position = "bottom",
legend.justification = "center",
legend.margin = margin(.5, 0, 0, 0, "cm")
) +
guides(colour = guide_legend(nrow = 1))
mase <- read_csv(here("results", "analysis", "final_mase.csv")) %>%
rename(" " = name)
mase_mean <-
mase %>%
summarise(across(where(is.numeric), mean)) %>%
mutate(` ` = "Media") %>%
relocate(` `)
mase %<>%
bind_rows(mase_mean) %>%
mutate(across(where(is.numeric), ~ round(., 2))) %>%
rename("svr" = svm)
kbl(mase,
booktabs = T,
align = c("lcccccccccc")) %>%
kable_classic() %>%
add_header_above(c(" " = 1, "MASE" = 5), align = "l") %>%
kable_styling(font_size = 15,
full_width = T,
latex_options = "hold_position") %>%
column_spec(1, width = "1cm") %>%
column_spec(3, width = "1cm") %>%
group_rows(start_row = 1,
end_row = 4,
label_row_css = "l",
latex_gap_space = "-0.25cm") %>%
group_rows(start_row = 5,
end_row = 5,
label_row_css = "l",
latex_gap_space = "-0.10cm") %>%
row_spec(5, bold = TRUE)
